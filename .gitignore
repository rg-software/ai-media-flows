# --- Model weights (never commit; note *where* they live in docs) ---
*.safetensors
*.ckpt
*.pt
*.pth
*.bin

# --- Transient locations ---
output/
temp/
assets-temp/

# --- Assets policy: LOCATION decides, NOT file type ---
# `assets/` holds the curated, tracked set of valuable artefacts. Anything placed
# there is committed regardless of format — .png, .glb, .fbx, .json, ... An asset's
# value does not depend on its extension, so there is deliberately NO *.glb / *.fbx /
# *.obj / *.stl / *.ply rule here. Generated and scratch output belongs in the
# transient locations above, which are ignored wholesale.
# Convention: promote into assets/ deliberately (2d via scripts/publish_assets.sh),
# never by dumping files there.

# --- ComfyUI / env scratch ---
comfy-env/
*.pixi*
__pycache__/
*.pyc
.python-version

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
