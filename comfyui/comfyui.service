# ComfyUI — systemd *user* service (as deployed on Beelink, cleaned).
#
# NOTE: this is a USER unit. Manage it with `systemctl --user`, never with sudo:
#   systemctl --user status  comfyui
#   systemctl --user restart comfyui
#   journalctl --user -u comfyui -f
# `sudo systemctl ... comfyui` looks at SYSTEM scope and says "not-found" —
# that is the trap that made "restart comfy" appear broken.
#
# Install (once):
#   mkdir -p ~/.config/systemd/user
#   cp comfyui.service ~/.config/systemd/user/comfyui.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now comfyui
#   sudo loginctl enable-linger rg_software   # start at boot WITHOUT an interactive login
#
# The deployed copy additionally had `User=`/`Group=` lines; those are invalid in a
# user unit (ignored) and are dropped here. Paths are hardcoded to rg_software's home;
# `%h` could be used instead for portability.

[Unit]
Description=ComfyUI
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/rg_software/Projects-Git/ComfyUI
ExecStart=/home/rg_software/Projects-Git/ComfyUI/venv/bin/python main.py --listen --disable-api-nodes

Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# ---------------------------------------------------------------------------
# MEMORY GUARD — do not remove.
#
# On 2026-09-16 loading Qwen-Image-Edit-2511 (19.6 GB UNet + 7.9 GB text encoder
# = 27.5 GB of model) on a 24 GB card forced CPU offload; the host has only
# 31 GB RAM and 512 MB swap, so the kernel thrashed and the WHOLE MACHINE hung
# and needed a manual reboot. The journal ended mid-load with no OOM-killer line.
# See comfyui/README.md -> "Hardware ceiling".
#
# These limits make the *cgroup* kill ComfyUI instead of letting it take the box
# down. The system stays up and SSH-reachable; `systemctl --user restart comfyui`
# recovers. Values assume 64 GB RAM (62 GiB usable): the OS/desktop needs ~5-7 GB headroom.
# Chosen as High = installed - 16 GB, Max = installed - 8 GB, i.e. never within
# ~6 GB of installed RAM (96 GB -> 72G/88G, 64 GB -> 48G/56G).
#
#   MemoryHigh    soft limit: this is where the kernel starts reclaiming hard.
#                 Page cache from mmap'd safetensors is evicted from here rather
#                 than being allowed to crowd out anonymous memory.
#   MemoryMax     hard limit: cgroup OOM-killer fires at this point. A clean,
#                 recoverable kill — never a machine-wide freeze.
#   MemorySwapMax caps swap use by this cgroup so it cannot thrash the disk. With
#                 a large swapfile in place this is what keeps the box responsive.
#
# Verify:  systemctl --user show comfyui -p MemoryHigh -p MemoryMax -p MemorySwapMax
# Look for: journalctl --user -u comfyui | grep -i -E 'oom|killed'
# Raise the limits only if RAM is upgraded; keep every value below (RAM - 6 GB).
# ---------------------------------------------------------------------------
MemoryAccounting=yes
MemoryHigh=48G
MemoryMax=56G
MemorySwapMax=8G

# NoNewPrivileges=true
# PrivateTmp=true
# (kept in the deployed unit; PrivateTmp can break custom nodes that expect a shared /tmp)

[Install]
WantedBy=default.target
